# ==============================================================================
# Engineering Document Intelligence & CAD Knowledge Copilot
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.
#
# IMPORTANT:
# - Local Windows development and Docker Compose are both supported.
# - Azure OpenAI and Azure AI Search credentials are OPTIONAL. The application
#   defaults to local/mock/deterministic providers if Azure variables are omitted.
# - Never commit your active .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Name and runtime environment of the application
APP_NAME="Engineering Document Intelligence & CAD Knowledge Copilot"
APP_ENV=development                # development | production | test
DEBUG=True                         # Set to False in production
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1

# Allowed CORS origins for browser clients
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL credentials and database name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=engineering_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL:
# Option A: Local Windows development (PostgreSQL running directly on Windows)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/engineering_copilot

# Option B: Docker Compose (inter-container networking via service name 'postgres')
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/engineering_copilot

# Whether container entrypoint runs 'alembic upgrade head' on startup
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 3. STORAGE & PROCESSING DIRECTORIES
# ------------------------------------------------------------------------------
# Paths resolved relative to repository root (mounted into /app/data in Docker)
DOCUMENTS_STORAGE_DIR=./data/documents
PROCESSED_STORAGE_DIR=./data/processed

# Document upload constraints
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500
PDF_MIN_NATIVE_TEXT_CHARS=50

# ------------------------------------------------------------------------------
# 4. DOCUMENT INTELLIGENCE & OCR CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: Path to Tesseract executable if not discovered on system PATH.
# - Windows default discovery: C:\Program Files\Tesseract-OCR\tesseract.exe
# - Linux/Docker: Discovered automatically on PATH (/usr/bin/tesseract)
TESSERACT_CMD=
OCR_DPI=300

# ------------------------------------------------------------------------------
# 5. CHUNKING & HYBRID RETRIEVAL CONFIGURATION
# ------------------------------------------------------------------------------
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
EMBEDDING_DIMENSIONS=1536

# Providers: "auto" (falls back to local/deterministic if Azure unconfigured), "local", "azure"
EMBEDDING_PROVIDER=auto
SEARCH_PROVIDER=auto
HYBRID_SEARCH_TOP_K=5

# ------------------------------------------------------------------------------
# 6. RETRIEVAL-AUGMENTED GENERATION (RAG) & AGENT CONFIGURATION
# ------------------------------------------------------------------------------
# Providers: "auto" (uses deterministic grounded RAG if Azure unconfigured), "local", "azure"
LLM_PROVIDER=auto
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
RAG_RELEVANCE_THRESHOLD=0.01
RAG_DEFAULT_TOP_K=5

# ------------------------------------------------------------------------------
# 7. AZURE FOUNDRY / AZURE OPENAI (OPTIONAL - STAGING ONLY)
# ------------------------------------------------------------------------------
# Leave empty for local development and CI testing.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# ------------------------------------------------------------------------------
# 8. AZURE AI SEARCH (OPTIONAL - STAGING ONLY)
# ------------------------------------------------------------------------------
# Leave empty for local development and CI testing.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_DOCUMENTS_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_CAD_INDEX_NAME=cad-knowledge-index

# ------------------------------------------------------------------------------
# 9. FRONTEND CLIENT & DOCKER COMPOSE PORTS
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
