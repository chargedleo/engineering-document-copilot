# ==============================================================================
# Engineering Document Intelligence & CAD Knowledge Copilot
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application & Server Settings
APP_NAME="Engineering Document Intelligence & CAD Knowledge Copilot"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=engineering_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/engineering_copilot

# Azure OpenAI Configuration (Optional for Milestone 2 - Staging Only)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Azure AI Search Configuration (Optional for Milestone 2 - Staging Only)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_DOCUMENTS_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_CAD_INDEX_NAME=cad-knowledge-index

# Storage & Processing Directories
DOCUMENTS_STORAGE_DIR=./data/documents
PROCESSED_STORAGE_DIR=./data/processed

# Document Intelligence & OCR Configuration (Milestone 3)
# Optional: Path to Tesseract OCR executable if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500
PDF_MIN_NATIVE_TEXT_CHARS=50
OCR_DPI=300

# Document Chunking & Hybrid Search Configuration (Milestone 4)
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROVIDER=auto
SEARCH_PROVIDER=auto
HYBRID_SEARCH_TOP_K=5

# Frontend Client Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
