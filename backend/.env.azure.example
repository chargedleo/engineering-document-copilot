# ==============================================================================
# Engineering Document Intelligence & CAD Knowledge Copilot
# Azure Cloud Integration & Deployment Environment Configuration
# ==============================================================================

# Application Runtime Configuration
APP_NAME="Engineering Document Intelligence & CAD Knowledge Copilot"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","https://stengcopilot06724.z13.web.core.windows.net","https://lively-river-014b48c0f.6.azurestaticapps.net"]

# ------------------------------------------------------------------------------
# 1. Azure Database for PostgreSQL Flexible Server
# ------------------------------------------------------------------------------
# Provisioned: psql-engcopilot-06724 (Standard_B1ms, Burstable Tier, Central US)
POSTGRES_USER=copilotadmin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=engineering_copilot
POSTGRES_HOST=psql-engcopilot-06724.postgres.database.azure.com
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://copilotadmin:YOUR_POSTGRES_PASSWORD@psql-engcopilot-06724.postgres.database.azure.com:5432/engineering_copilot?ssl=require

# ------------------------------------------------------------------------------
# 2. Azure OpenAI Service
# ------------------------------------------------------------------------------
# Provisioned: aoai-engineering-copilot (S0, East US)
AZURE_OPENAI_ENDPOINT=https://aoai-engineering-copilot-06724.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=azure
EMBEDDING_PROVIDER=azure

# ------------------------------------------------------------------------------
# 3. Azure AI Search Service
# ------------------------------------------------------------------------------
# Provisioned: search-engineering-copilot (Free Tier, East US)
AZURE_SEARCH_ENDPOINT=https://search-engineering-copilot.search.windows.net
AZURE_SEARCH_API_KEY=YOUR_AZURE_SEARCH_KEY
AZURE_SEARCH_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_DOCUMENTS_INDEX_NAME=engineering-docs-index
AZURE_SEARCH_CAD_INDEX_NAME=cad-knowledge-index
SEARCH_PROVIDER=azure
HYBRID_SEARCH_TOP_K=5

# ------------------------------------------------------------------------------
# 4. Azure Blob Storage
# ------------------------------------------------------------------------------
# Provisioned: stengcopilot06724 (Standard_LRS, StorageV2, East US)
AZURE_STORAGE_ACCOUNT=stengcopilot06724
AZURE_STORAGE_CONTAINER_NAME=documents
AZURE_STORAGE_CONNECTION_STRING=YOUR_STORAGE_CONNECTION_STRING
STORAGE_PROVIDER=azure

# Storage Directories
DOCUMENTS_STORAGE_DIR=/app/data/documents
PROCESSED_STORAGE_DIR=/app/data/processed

# Document Intelligence & Processing
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500
PDF_MIN_NATIVE_TEXT_CHARS=50
OCR_DPI=300
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
